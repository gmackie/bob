    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@bob/prettier-config": "workspace:*",
    "@bob/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "oxlint": "1.94.0"
  },
  "prettier": "@bob/prettier-config"
}
