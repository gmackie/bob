# @gmacko/emulate runtime state. PGlite clusters are generated, platform-
# specific database files and must never be committed or reused by CI.
/data/pglite/

# Preflight local build metadata. The TrueFlight review workflow sources
# (.preflight/review/*.review.yaml) stay tracked; their compiled artifacts are
# ignored by apps/mobile-bob/.gitignore.
**/.preflight/*
!**/.preflight/review/
**/.preflight/review/*
!**/.preflight/review/*.review.yaml

# check-events v2 stream + CTRF (CI + agent worktrees)
.fg/

# Expo machine-local state: device history, dev-server settings, build
# logs and image caches. 31 files / 3.6 MB were committed before this.
.expo/

# Private latency/observability evidence
**/.fg/observability/

# Preserved CI reports (uploaded as workflow artifacts)
/ci-report/
