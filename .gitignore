node_modules
dist/
.next/
.turbo/
.cache/
*.tsbuildinfo
.env
.env.local
.env.production
.env.*.local

# Generated OpenAPI specs
dist/openapi/

# Python
__pycache__/
*.egg-info/
.pytest_cache/
packages/research-backend/.venv/
.ruff_cache/
.gstack/
.wrangler/
.deploy/

# @gmacko/emulate runtime state. PGlite clusters are generated, platform-
# specific database files and must never be committed or reused by CI.
/data/pglite/

# Preflight local build metadata
.preflight/

# check-events v2 stream + CTRF (CI + agent worktrees)
.fg/

# Expo machine-local state: device history, dev-server settings, build
# logs and image caches. 31 files / 3.6 MB were committed before this.
.expo/

# Private latency/observability evidence
**/.fg/observability/

# Preserved CI reports (uploaded as workflow artifacts)
/ci-report/

# vinext 1.x build/dev outputs (its next-env.d.ts references .next types
# that only exist after a build)
.vinext/
apps/bob/next-env.d.ts
apps/blder/next-env.d.ts
apps/ooda-edge/next-env.d.ts
