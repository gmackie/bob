{
  "name": "@bob/settings",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./schemas": "./src/schemas.ts",
    "./schema": "./src/schema.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "oxlint -c ../../../../.oxlintrc.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "zod": "4.6.7",
    "@bob/schema": "workspace:*"
  },
  "devDependencies": {
    "@bob/prettier-config": "workspace:*",
    "@bob/tsconfig": "workspace:*",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "oxlint": "1.94.0"
  },
  "prettier": "@bob/prettier-config"
}
