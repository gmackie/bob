{
  "name": "@bob/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./client-neon": {
      "types": "./dist/client-neon.d.ts",
      "default": "./src/client-neon.ts"
    },
    "./client-pglite": {
      "types": "./dist/client-pglite.d.ts",
      "default": "./src/client-pglite.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "oxlint -c ../../../../.oxlintrc.json",
    "push": "pnpm with-env drizzle-kit push",
    "migrate": "tsx src/migrate.ts",
    "migrate:dry": "tsx src/migrate.ts --dry-run",
    "migrate:bootstrap": "tsx src/migrate.ts --bootstrap",
    "studio": "pnpm with-env drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "migrate:production": "tsx src/production-migrate.ts"
  },
  "dependencies": {
    "@bob/schema": "workspace:*",
    "@electric-sql/pglite": "0.5.16",
    "@gmacko/core": "workspace:*",
    "@neondatabase/serverless": "1.2.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@bob/prettier-config": "workspace:*",
    "@bob/tsconfig": "workspace:*",
    "@types/pg": "8.23.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "oxlint": "1.94.0"
  },
  "prettier": "@bob/prettier-config"
}
