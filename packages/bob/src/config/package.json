{
  "name": "@bob/config",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "default": "./src/integrations.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "oxlint -c ../../../../.oxlintrc.json",
    "test": "node test/integrations.test.mjs",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@bob/prettier-config": "workspace:*",
    "@bob/tsconfig": "workspace:*",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "oxlint": "1.94.0"
  },
  "prettier": "@bob/prettier-config"
}
