{
  "name": "@bob/agents",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "oxlint -c ../../../../.oxlintrc.json",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "zod": "4.6.7",
    "@bob/schema": "workspace:*"
  },
  "devDependencies": {
    "@bob/prettier-config": "workspace:*",
    "@bob/tsconfig": "workspace:*",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "oxlint": "1.94.0"
  },
  "prettier": "@bob/prettier-config"
}
