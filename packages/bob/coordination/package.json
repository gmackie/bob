{
  "name": "@bob/coordination-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs --write",
    "check:generated": "node scripts/generate.mjs --check",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM generated/client.ts test/client-types.ts",
    "verify": "npm run check:generated && npm test && npm run typecheck",
    "coordinate": "node runtime/cli.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "bin": {
    "bob-coordinate": "runtime/cli.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "exports": {
    "./coordinator": "./runtime/coordinator.mjs",
    "./client": "./generated/client.mjs",
    "./execution": "./runtime/execution.mjs",
    "./execution-port": "./runtime/execution-port.mjs"
  }
}
