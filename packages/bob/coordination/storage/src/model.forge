/// Internal storage; not a public CRUD surface. The adapter owns transactions.
export resource CoordinationPlan @tenant @versioned {
  id : id
  owner : text length 1..128
  definition : json
  state : text length 1..32
  list by owner
}
export resource CoordinationItem @tenant @versioned {
  id : id
  owner : text length 1..128
  planId : text length 1..128
  snapshot : json
  list by owner, planId
}
export resource CoordinationOperation @tenant {
  id : id
  owner : text length 1..128
  receipt : json
  list by owner
}
export resource CoordinationEvent @tenant {
  id : id
  owner : text length 1..128
  resourceId : text length 1..128
  resourceVersion : integer >= 1
  sequence : integer >= 1
  recordedAt : datetime
  unique sequence
  list by owner, sequence
}

export resource CoordinationAttempt @tenant {
  id : id
  owner : text length 1..128
  planId : text length 1..128
  itemId : text length 1..128
  requestId : text length 1..128
  operationId : text length 1..128
  request : json
  state : text length 1..32
  admission : json?
  terminal : json?
  lastSequence : integer >= 0
  leaseOwner : text? length 1..128
  leaseUntil : integer?
  unique requestId
  list by owner, planId, state
}

/// Kanbanger lifecycle effects. A row commits in the same transaction as the
/// coordination fact it reports; a worker delivers it later. Never a public API.
export resource CoordinationIssueEffect @tenant {
  id : id
  owner : text length 1..128
  attemptId : text length 1..128
  fact : text length 1..64
  payload : json
  status : text length 1..32
  deliveryAttempts : integer >= 0
  nextAttemptAt : integer >= 0
  lastError : text? length 1..2000
  leaseOwner : text? length 1..128
  leaseUntil : integer?
  createdAt : datetime
  deliveredAt : datetime?
  unique attemptId, fact
  list by owner, status, nextAttemptAt
}
