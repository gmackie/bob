[Unit]
Description=OODA local embedding runtime (Ollama)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ollama
Group=ollama
Environment=HOME=/var/lib/ooda-ollama
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/ooda-ollama/models
Environment=OLLAMA_NO_CLOUD=1
ExecStart=/usr/local/bin/ollama serve
Restart=always
RestartSec=10

StateDirectory=ooda-ollama
StateDirectoryMode=0700
ReadWritePaths=/var/lib/ooda-ollama
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

LimitNOFILE=65536
MemoryMax=6G
TasksMax=512

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ooda-ollama

[Install]
WantedBy=multi-user.target
