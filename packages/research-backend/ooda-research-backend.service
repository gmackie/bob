[Unit]
Description=OODA Research Backend (Python/FastAPI sidecar)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bob
Group=bob
WorkingDirectory=/opt/ooda-research-backend/current
EnvironmentFile=/etc/ooda/research-backend.env
Environment=HOME=/var/lib/ooda-research-backend
ExecStart=/opt/ooda-research-backend/current/.venv/bin/uvicorn \
  research_backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10

StateDirectory=ooda-research-backend
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

LimitNOFILE=65536
MemoryMax=2G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ooda-research-backend

[Install]
WantedBy=multi-user.target
