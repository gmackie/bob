{
  "name": "@gmacko/bob-client",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi/bob.json": "./openapi/bob.json",
    "./query": "./src/query.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "pnpm -w run generate:openapi:bob && openapi-typescript openapi/bob.json -o src/schema.d.ts"
  },
  "dependencies": {
    "@gmacko/bob": "workspace:*",
    "@gmacko/core": "workspace:*",
    "effect": "4.1.4",
    "openapi-fetch": "0.17.0",
    "@tanstack/react-query": "5.108.0"
  },
  "devDependencies": {
    "@gmacko/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
