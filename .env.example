# OODA
# Node.js does not expand ~. Use an absolute path or leave unset
# (defaults to $HOME/.ooda/threads/).
# OODA_STORAGE_ROOT=/Users/you/.ooda/threads/

# URL of the research-backend Python sidecar (FastAPI).
# Start with: pnpm dev:research
RESEARCH_API_URL=http://localhost:8000

# Paths to private Obsidian vaults. Optional -- features are disabled when unset.
PERSONAL_VAULT_PATH=
RESEARCH_VAULT_PATH=
PERSONAL_WEBSITE_PATH=

# Shared secret for runner↔server auth. Leave empty for dev (allows all).
OODA_RUNNER_SECRET=

# Voice playback. OODA resolves text from canonical assistant events and never
# exposes this provider key to mobile. Generate a random 32+ byte grant secret.
OODA_TTS_GRANT_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional; defaults shown here keep the exact provider choices configurable.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128

# Conversational host and visible fallback order: Grok -> Claude -> OpenAI.
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OODA_GROK_HOST_MODEL=grok-4.5
OODA_CLAUDE_HOST_MODEL=claude-opus-4-6
OODA_OPENAI_HOST_MODEL=gpt-5

# Approved OODA proposal delivery into Bob. The runner keeps this adapter dark
# until the kill switch is explicitly enabled; the API key remains runner-only.
BOB_API_URL=
BOB_API_KEY=
BOB_WORKSPACE_ID=
OODA_BOB_DELIVERY_ENABLED=false

# Approved curated-note delivery. The runner writes only under Captures/,
# Areas/, or Resources/Chat Extractions/ and never stages unrelated vault files.
OODA_OBSIDIAN_DELIVERY_ENABLED=false
OODA_OBSIDIAN_VAULT_PATH=/Users/mackieg/obsidian
OODA_OBSIDIAN_VAULT_NAME=

# Approved opportunity-review delivery into one idea-stage BizPulse venture.
# Use a BizPulse API key (biz_* or gmk_*); it remains runner-only.
OODA_BIZPULSE_DELIVERY_ENABLED=false
OODA_BIZPULSE_API_URL=https://bizpulse.cc
OODA_BIZPULSE_API_KEY=

# Read-only ForgeGraph changeset/build/test evidence disclosed through context
# packs. Raw diffs are never included in host prompts.
FORGEGRAPH_API_URL=https://forgegraf.com
FORGEGRAPH_API_KEY=
FORGEGRAPH_CONTEXT_APPS=ooda,bob,bizpulse,kanbanger

# CORS origin for the Python research-backend sidecar.
OODA_CORS_ORIGIN=http://localhost:3000

# --- Usage quotas ---
# Force plan usage limits on/off. When unset, mirrors Stripe billing enablement
# (see packages/bob/src/config/src/integrations.ts). Set true to enforce free/premium/pro
# ceilings for seats, active agents, task runs, storage, API keys, and webhook volume.
# ENFORCE_USAGE_QUOTAS=false

# --- Billing (Stripe) ---
# Entitlement gating is only ENFORCED when the Stripe integration is toggled on
# in packages/bob/src/config/src/integrations.ts. These values wire the
# subscription -> tenants.plan sync and checkout.
# Secret key used for the Stripe REST API (checkout sessions).
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Stripe recurring price IDs mapped to the paid plans.
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=
