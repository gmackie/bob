[Unit]
Description=Bob durable software factory coordinator (REST and MCP)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/bob/.bob/coordination

[Service]
Type=simple
User=bob
Group=bob
WorkingDirectory=/opt/bob-coordinator/current
ExecStart=/home/bob/.local/bin/node runtime/serve.mjs --database /home/bob/.bob/coordination/coordination.sqlite --principals /etc/bob/coordination/principals.json --kanbanger /etc/bob/coordination/kanbanger.json --host 127.0.0.1 --port 4780
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/bob/.bob/coordination /mnt/HC_Volume_106611335/bob/coordination

[Install]
WantedBy=multi-user.target
