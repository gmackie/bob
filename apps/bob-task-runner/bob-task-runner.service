# Reference systemd unit for the Bob Task Runner on hetzner-bob.
# Install: copy to /etc/systemd/system/bob-task-runner.service, then
#   systemctl daemon-reload && systemctl enable --now bob-task-runner
#
# Secrets/config live in the EnvironmentFile (NOT in the repo). At minimum set:
#   BOB_API_URL, BOB_API_KEY, BOB_WORKSPACE_ID  (run reporting)
#   PULSE_API_KEY                                (codex/bizpulse, optional)
# Linear key is read from /home/bob/.linear-key by default.

[Unit]
Description=Bob Task Runner (Linear issue -> codex agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bob
WorkingDirectory=/opt/bob/task-runner
EnvironmentFile=/opt/bob/task-runner/.env
Environment=NODE_ENV=production
Environment=PATH=/home/bob/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node task-runner.js
Restart=always
RestartSec=10

# Sandbox hardening. IMPORTANT: with ProtectSystem=strict the filesystem is
# read-only except ReadWritePaths, so ReadWritePaths MUST cover wherever the
# runner lazy-clones repos. The clone root is /home/bob/dev, which on
# hetzner-bob is a symlink to a mounted Hetzner volume
# (/mnt/HC_Volume_106611335); without whitelisting that volume, every fresh
# `git clone` fails with "Read-only file system" and no code-lane issue can
# ever be claimed. Host-specific mount paths are added via a drop-in
# (bob-task-runner.service.d/clone-volume.conf) so this reference unit stays
# node-agnostic.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
PrivateTmp=true
ReadWritePaths=/opt/bob/task-runner /home/bob /tmp

[Install]
WantedBy=multi-user.target
