{
  "name": "@bob/mobile",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "update:development": "APP_VARIANT=development npx eas-cli@20.5.1 update --channel development --environment development",
    "update:beta": "APP_VARIANT=preview npx eas-cli@20.5.1 update --channel beta --environment preview",
    "update:production": "APP_VARIANT=production npx eas-cli@20.5.1 update --channel production --environment production",
    "update:production:rollout": "APP_VARIANT=production npx eas-cli@20.5.1 update --channel production --environment production --rollout-percentage 10",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "oxlint -c ../../.oxlintrc.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ios:device:production": "APP_ENV=production API_URL=https://bob.blder.bot AUTH_URL=https://bob.blder.bot OODA_API_URL=https://ooda.blder.bot GATEWAY_PUBLIC_URL=wss://ws.blder.bot expo run:ios --configuration Release --no-bundler --device"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.26",
    "@bob/arcade": "workspace:*",
    "@bob/config": "workspace:*",
    "@bob/notifications": "workspace:*",
    "@bob/sdlc-view": "workspace:*",
    "@bob/ws": "workspace:*",
    "@expo/metro-runtime": "58.0.17",
    "@gmacko/bob-client": "workspace:*",
    "@gmacko/ooda-client": "workspace:*",
    "@legendapp/list": "3.7.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "8.36.0",
    "@tanstack/react-query": "5.108.0",
    "@trpc/client": "11.29.5",
    "@trpc/server": "11.29.5",
    "better-auth": "1.7.26",
    "expo": "58.0.26",
    "expo-asset": "58.0.21",
    "expo-audio": "58.0.12",
    "expo-camera": "58.0.14",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-dev-client": "58.0.21",
    "expo-device": "58.0.5",
    "expo-haptics": "58.0.8",
    "expo-linking": "58.0.17",
    "expo-notifications": "58.1.9",
    "expo-router": "58.0.32",
    "expo-secure-store": "58.0.3",
    "expo-speech-recognition": "58.0.1",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-updates": "58.0.22",
    "expo-web-browser": "58.1.0",
    "nativewind": "5.0.0-preview.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "3.3.0",
    "react-native-markdown-display": "7.0.2",
    "react-native-reanimated": "4.7.2",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-worklets": "0.13.1",
    "superjson": "2.2.6",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@bob/prettier-config": "workspace:*",
    "@bob/tailwind-config": "workspace:*",
    "@bob/tsconfig": "workspace:*",
    "@sentry/cli": "3.8.2",
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/uuid": "11.0.0",
    "babel-preset-expo": "58.0.26",
    "metro-cache": "0.88.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "oxlint": "1.94.0"
  },
  "prettier": "@bob/prettier-config",
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  }
}
