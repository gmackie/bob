{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.14.0",
      "pnpm": "10.12.1",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "API_URL": "http://localhost:3000",
        "AUTH_URL": "http://localhost:3000"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "channel": "development"
    },
    "development:device": {
      "extends": "development",
      "env": {
        "API_URL": "https://bob.blder.bot",
        "AUTH_URL": "https://bob.blder.bot",
        "GATEWAY_PUBLIC_URL": "wss://ws.blder.bot",
        "OODA_API_URL": "https://ooda.blder.bot"
      },
      "ios": {
        "simulator": false
      }
    },
    "beta": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging"
      },
      "ios": {
        "enterpriseProvisioning": "adhoc"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "beta"
    },
    "preview": {
      "extends": "beta",
      "env": {
        "APP_VARIANT": "preview"
      },
      "channel": "preview"
    },
    "beta:production-api": {
      "extends": "beta",
      "env": {
        "APP_ENV": "staging",
        "API_URL": "https://bob.blder.bot",
        "AUTH_URL": "https://bob.blder.bot",
        "GATEWAY_PUBLIC_URL": "wss://ws.blder.bot"
      },
      "channel": "beta-production"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "APP_VARIANT": "production"
      },
      "ios": {
        "buildConfiguration": "Release-production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "distribution": "store"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6787732773",
        "appleTeamId": "P4SWQXAB5H"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "internal"
      }
    },
    "beta": {
      "ios": {
        "ascAppId": "6787732773",
        "appleTeamId": "P4SWQXAB5H"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "internal"
      }
    }
  }
}
