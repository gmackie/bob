{
  "name": "@gmacko/ooda-runner",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules coverage",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:integrations": "tsx src/integration-only.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@bob/execution": "workspace:*",
    "@bob/ws": "workspace:*",
    "@forgegraph/check-events": "0.1.7",
    "@gmacko/core": "workspace:*",
    "@gmacko/ooda": "workspace:*",
    "@trpc/client": "11.29.5",
    "superjson": "2.2.6",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gmacko/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
