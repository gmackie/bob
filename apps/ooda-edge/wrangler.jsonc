{
  "name": "ooda-blder-bot",
  "main": "./worker/index.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "ooda.blder.bot", "custom_domain": true },
    { "pattern": "ooda.gmac.io", "custom_domain": true },
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
  },
  "hyperdrive": [
    {
      // OODA shares Bob's database (research_thread, runner_*, api_keys all
      // live in the `bob` DB). Bind Bob's live Hyperdrive config
      // (blder-bot-db → pg-db.forgegraf.com/bob). The former OODA-only config
      // (b053c840…) was pruned at the CF 25-Hyperdrive account cap, taking the
      // whole edge DB down; the separate `ooda_production` DB is unused.
      "binding": "HYPERDRIVE",
      "id": "c1f467f772dc4ce99d99e572df74c121",
    },
  ],
  "vars": {
    "REQUIRE_AUTH": "true",
    "FRONTEND_URL": "https://ooda.blder.bot",
    "NODE_ENV": "production",
    "OODA_ROLLOUT_STAGE": "durable_work",
    "OODA_ROLLOUT_OWNER_IDS": "tkE66fMc4mevdYYjtq78ALErJ7QnhAge",
    "OODA_DOGFOOD_STARTED_AT": "2026-08-09T15:44:45.000Z",
    "OODA_ROLLOUT_KILL_SWITCH": "false",
    "OODA_AGENT_JOB_ENABLED_PROVIDERS": "codex",
    "OODA_AGENT_JOB_ENABLED_CLASSES": "read_only_research,scratch_prototype",
    "FORGEGRAPH_API_URL": "https://forgegraf.com",
    "FORGEGRAPH_CONTEXT_APPS": "ooda,bob,bizpulse,kanbanger",
    "RESEARCH_API_URL": "https://research.gmac.io",
    "ELEVENLABS_TTS_MODEL": "eleven_flash_v2_5",
    "ELEVENLABS_TTS_OUTPUT_FORMAT": "mp3_44100_128",
  },
}
