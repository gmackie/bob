{
  "name": "@bob/server",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "bob-server": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/bin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "15.1.0"
  },
  "devDependencies": {
    "@bob/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "exports": {
    "./process-tree": {
      "types": "./dist/process-tree.d.ts",
      "default": "./src/process-tree.ts"
    },
    "./startup-timeout": {
      "types": "./dist/startup-timeout.d.ts",
      "default": "./src/startup-timeout.ts"
    },
    "./bundled-resources": {
      "types": "./dist/bundled-resources.d.ts",
      "default": "./src/bundled-resources.ts"
    }
  }
}
