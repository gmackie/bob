{
  "name": "@bob/desktop",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main.js",
  "productName": "Bob",
  "scripts": {
    "dev": "pnpm run --parallel dev:bundle dev:electron",
    "dev:bundle": "tsdown --watch",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "tsdown",
    "start": "node scripts/start-electron.mjs",
    "stage": "node scripts/stage-packaging.mjs",
    "prepackage": "node scripts/stage-packaging.mjs",
    "package": "pnpm build && node scripts/package-desktop.mjs",
    "dist": "pnpm package",
    "build:daemon": "node scripts/build-daemon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build:app": "node scripts/build-node-app.mjs"
  },
  "dependencies": {
    "ws": "8.23.0",
    "@gmacko/bob-client": "workspace:*"
  },
  "devDependencies": {
    "@bob/server": "workspace:*",
    "@bob/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "electron-builder": "26.18.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "electron-builder-squirrel-windows": "26.18.0",
    "electron": "45.3.4",
    "yaml": "2.9.1",
    "effect": "4.1.4",
    "@gmacko/core": "workspace:*"
  }
}
