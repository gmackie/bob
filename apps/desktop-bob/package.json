{
  "name": "@bob/desktop",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main.js",
  "productName": "Bob",
  "scripts": {
    "dev": "pnpm run --parallel dev:bundle dev:electron",
    "dev:bundle": "tsdown --watch",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "tsdown",
    "start": "node scripts/start-electron.mjs",
    "stage": "node scripts/stage-packaging.mjs",
    "prepackage": "node scripts/stage-packaging.mjs",
    "package": "pnpm build && electron-builder --config electron-builder.yml",
    "dist": "pnpm package",
    "build:daemon": "node scripts/build-daemon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build:app": "node scripts/build-node-app.mjs"
  },
  "dependencies": {
    "ws": "catalog:"
  },
  "devDependencies": {
    "@bob/server": "workspace:*",
    "@bob/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "electron-builder": "^26.15.3",
    "tsdown": "^0.20.3",
    "typescript": "catalog:",
    "vitest": "^4.1.11",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron": "41.10.3",
    "yaml": "^2.9.0"
  }
}
