{
  "name": "@gmacko/ooda-cli",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "ooda": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules coverage",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@gmacko/ooda": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gmacko/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
